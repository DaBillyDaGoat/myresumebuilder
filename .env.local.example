# MyResumeBuilder Environment Variables
# Copy this file to .env.local and fill in your values

# Anthropic Claude API Key
# Get it at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase Database
# Get URL and anon key from: https://supabase.com/ → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJyour-anon-key-here

# Resend Email Service
# Get API key at: https://resend.com/
RESEND_API_KEY=re_your-key-here

# Admin Dashboard Password
# Change this before deploying!
ADMIN_PASSWORD=change-me-before-deploy

# Public App URL (used for email links)
NEXT_PUBLIC_APP_URL=https://myresumebuilder.org
